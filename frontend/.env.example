# Frontend Environment Variables
# Only NEXT_PUBLIC_* variables are exposed to the browser

# API base (must include `/api` — see src/lib/api.ts). Use `.env.local` for dev.
# Production Docker builds load `frontend/.env.production` during `next build`.
NEXT_PUBLIC_API_URL=http://localhost:8000/api

# Note: Never commit actual API keys, secrets, or credentials
